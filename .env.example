# OneLedger configuration. Copy to .env (scripts/setup_local.py does this and generates keys).
# Never commit .env. Values below are placeholders.

# --- Runtime --------------------------------------------------------------------------
# local | test | preview | production
APP_ENV=local
# trusted web origin
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------------
# Restricted runtime role (member of oneledger_app, NOBYPASSRLS). Hosted: add ?sslmode=require
DATABASE_URL=postgresql+psycopg://oneledger_runtime:CHANGE_ME@localhost:54329/oneledger
# Migration owner; used only by `make migrate`, never by the running app.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@localhost:54329/oneledger
# session | transaction (Supabase transaction pooler)
DATABASE_POOL_MODE=session

# --- Secrets (32 random bytes, urlsafe base64). Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_ENCRYPTION_KEY=
SECRET_KEY_VERSION=1
# during rotation: "1:oldkey"
PREVIOUS_SECRET_ENCRYPTION_KEYS=
TOKEN_HASH_KEY=

# --- Sessions & auth --------------------------------------------------------------------
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# must be true in preview/production
REQUIRE_MFA=false
# must be true in preview/production
COOKIE_SECURE=false
# shared by web BFF and API (trusted client IP header)
BFF_SHARED_SECRET=

# --- Jobs / scheduler ---------------------------------------------------------------------
# bearer for POST /api/internal/runner (>= 32 chars)
SCHEDULER_SECRET=
JOB_BATCH_SIZE=500
JOB_TIME_BUDGET_SECONDS=20

# --- AI (disabled by default; owner opt-in still required) --------------------------------
# Providers: openrouter (default), anthropic, openai, gemini, groq, deepseek, mistral, together,
# ollama (local only), custom. Empty AI_MODEL = the provider's default (openrouter: anthropic/claude-opus-5).
AI_ENABLED=false
AI_PROVIDER=openrouter
AI_MODEL=
# Optional operator-defined OpenAI-compatible endpoint for provider "custom" (never set from the UI)
AI_CUSTOM_BASE_URL=
# Optional server-wide key, used only for people who have not saved their own key in Settings.
AI_API_KEY=
# Most AI requests one person can make per day
AI_DAILY_BUDGET=50

# --- Limits / retention ---------------------------------------------------------------------
RAW_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=20971520
MAX_IMPORT_ROWS=100000

# --- Web (Next.js server only; nothing here is NEXT_PUBLIC) -----------------------------------
ONELEDGER_API_INTERNAL_URL=http://localhost:8000

# --- MCP (local stdio server) -----------------------------------------------------------------
ONELEDGER_API_URL=http://localhost:8000
# create in Settings → API tokens (read-only)
ONELEDGER_READ_TOKEN=
